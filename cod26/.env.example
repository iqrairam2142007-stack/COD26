# Copy to .env and fill in. Never commit .env.
# URL -> "oss_host" in .insforge/project.json
# Key -> npx @insforge/cli secrets get ANON_KEY
REACT_APP_INSFORGE_URL=
REACT_APP_INSFORGE_ANON_KEY=

# Razorpay environment: 'test' or 'live'.
# The fee amount itself lives in the public.pricing table, not here.
REACT_APP_PAYMENT_ENV=test
